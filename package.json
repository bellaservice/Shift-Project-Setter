{
  "name": "shift-project-setter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:new": "supabase migration new",
    "db:list": "supabase migration list --linked",

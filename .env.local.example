# Copy this file to .env.local and fill in values from
# Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only used when generating the Arbetsdagbok PDF, which drives a
# Chrome that is already installed on the machine. Leave blank and the server
# looks in the usual Chrome/Edge locations for Windows, macOS and Linux; set it
# if Chrome lives somewhere else, or if the host has no browser on PATH.
# Example (Windows): CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
